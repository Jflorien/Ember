# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used to build OAuth / email redirect URLs (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Powers the AI narration co-pilot on /dm (console.anthropic.com). Optional —
# the app builds and runs fine without it, the Suggest button just errors.
ANTHROPIC_API_KEY=sk-ant-...
